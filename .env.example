# Frontend
VITE_API_BASE_URL=http://localhost:8787
VITE_PUBLIC_BASE_URL=http://localhost:3001

# Backend / Serverless API
MONGODB_URI=
MONGODB_DB=ai_interview_platform
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_interview_platform

# --- AI API Configuration Options ---
# Option 1: FREE Groq API (Recommended for 100% Free & Fast API)
# Get a free key at: https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_your_free_groq_key_here

# Option 2: FREE Google Gemini API (OpenAI Compatible Endpoint)
# Get a free key at: https://aistudio.google.com/app/apikey
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=AIzaSy_your_free_gemini_key_here

# Option 3: Standard OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACKS=gpt-4o
